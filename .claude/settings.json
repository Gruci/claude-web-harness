{
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "Skill(*)",
      "TaskCreate(*)",
      "TaskUpdate(*)",
      "TaskGet(*)",
      "TaskList(*)",
      "TaskStop(*)",
      "TaskOutput(*)",
      "NotebookEdit(*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/hooks/lazy-persona.md",
            "timeout": 5,
            "statusMessage": "Loading lazy mode"
          },
          {
            "type": "command",
            "command": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 || echo '[GIT CHECK] git 저장소가 아님 — 게이트는 git ls-files 로 대상을 모은다. 저장소가 아니면 검사 대상이 0개라 전 게이트가 무력화되고 EDITING.md 직렬화도 안 돈다. 코딩 전에 git init + .gitignore 가 최우선이다.'; git remote get-url origin >/dev/null 2>&1 || echo '[GITHUB CHECK] GitHub 원격(origin) 미설정 — 코드가 이 컴퓨터에만 있는 상태다. 사용자에게 레포 URL을 받아 remote 연결 + 최초 푸시부터 하라. Stop 게이트(check_git_remote)가 원격 없이는 세션 종료를 차단한다.'",
            "timeout": 10,
            "statusMessage": "Checking git repo"
          },
          {
            "type": "command",
            "command": "test -f harness_profile.py || echo '[HARNESS SETUP] harness_profile.py 없음 — 커널이 이 프로젝트에 대해 아무것도 모르는 상태다. 레이어를 요구하는 게이트가 전부 [SKIP] 으로 꺼져 있다. 코딩 전에 `python -X utf8 harness_install.py --preset web_fastapi_react` 를 돌리고(프리셋 목록은 --list) 레이어 이름을 실물에 맞춰라.'",
            "timeout": 10,
            "statusMessage": "Checking harness profile"
          },
          {
            "type": "command",
            "command": "python --version >/dev/null 2>&1 || echo '[PYTHON CHECK] python 실행 불가 — Stop/PostToolUse 게이트가 전부 무력화된다(훅은 exit 2만 차단, 실행 실패는 조용히 통과). 코딩 전에 python PATH부터 복구하라.'; node --version >/dev/null 2>&1 || echo '[NODE CHECK] node 실행 불가 — impeccable UI 훅이 무력화된다. UI 작업 전에 node PATH를 복구하라.'",
            "timeout": 10,
            "statusMessage": "Checking gate interpreters"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/git_staleness.py",
            "timeout": 25,
            "statusMessage": "Checking backlog freshness"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_context_growth.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_context_diet.py",
            "timeout": 10,
            "statusMessage": "Context diet gate"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_agent_return.py",
            "timeout": 15,
            "statusMessage": "Agent return size gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_file_rules.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/skills/impeccable/scripts/hook.mjs",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_editing_lock.py"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/check_coding_rules.py"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/check_git_remote.py"
          }
        ]
      }
    ]
  }
}
