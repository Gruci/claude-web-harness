# Local secrets; sanitized templates remain shareable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.key
*.p12
*.pfx

# Python environments, caches, and generated packages.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/

# JavaScript dependencies and generated caches; keep dependency lockfiles.
node_modules/
.npm/
.pnpm-store/
*.tsbuildinfo

# Local logs, databases, dumps, and temporary files.
*.log
logs/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*_dump.sql
*.dump
*.tmp
*.bak
*.swp
*.swo

# SQL source and migrations are intentionally not excluded.

# Editor and operating-system state.
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Agent state is local; shared instructions, hooks, and configuration are tracked.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# 과업 보드 — "지금 누가 무엇을 잡고 있나". 세션이 전부 같은 머신에서 도니 파일시스템이 곧
# 공유 채널이고, git 을 거치면 모든 세션이 한 자리를 고쳐 충돌하고 보드를 보이려고 머지가
# 필요해진다(원류 MIS 2026-09 실측: 보드 전용 PR 51건 = 전체의 25%, 충돌 해소 34건).
# 자리가 레포 루트인 이유는 에이전트 중립이다 — `.claude/` 밑이면 Codex 가 남의 전용 폴더를
# 드나들어야 한다. README.md 만 추적한다 — 프로토콜 정본이라 새 clone 에도 있어야 한다.
workboard/*
!workboard/README.md

# 작업별 격리 체크아웃 — 위 보드와 같은 에이전트 중립 자리. 정본 목록은 폴더가 아니라
# `git worktree list` 다. `.claude/worktrees/` 행은 EnterWorktree 툴 생성분 호환용으로 남긴다.
worktrees/
.codex/auth.json
.codex/history.jsonl
.codex/sessions/
.codex/log/
.codex/tmp/
.codex/worktrees/

# 이 레포는 배포본이라 자기 작업 산출물을 싣지 않는다. 로컬 보관은 하고 추적만 막는다 —
# `harness_gates/archive_not_shipped.py` 가 같은 규칙을 게이트로 강제하고, gitignore 가
# 없으면 `git add -A` 한 번에 다시 추적돼 그 게이트가 매번 걸린다.
# clone 해 간 프로젝트는 자기 archive 를 커밋하는 게 맞으므로 이 행은 따라가지 않는다.
docs/tasks/archive/
