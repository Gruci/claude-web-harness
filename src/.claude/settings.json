{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(python batches/*.py*)",
      "Bash(python -m pytest*)",
      "Bash(python kofia_web.py*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"print(open('.claude/hooks/lazy-persona.md', encoding='utf-8').read())\"",
            "timeout": 10,
            "statusMessage": "Loading lazy mode"
          },
          {
            "type": "command",
            "command": "node --version >/dev/null 2>&1 || echo \"[NODE CHECK] node 실행 불가 - impeccable UI 디자인 훅이 무력화된다. UI 작업 전에 node PATH를 복구하라.\"",
            "timeout": 10,
            "statusMessage": "Checking node for impeccable"
          },
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/git_staleness.py",
            "timeout": 25,
            "statusMessage": "Checking backlog freshness"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_context_diet.py",
            "timeout": 10,
            "statusMessage": "Context diet gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_file_rules.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/skills/impeccable/scripts/hook.mjs",
            "timeout": 10,
            "statusMessage": "Checking UI design"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_agent_return.py",
            "timeout": 15,
            "statusMessage": "Agent return size gate"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_context_growth.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_editing_lock.py"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/check_coding_rules.py"
          }
        ]
      }
    ]
  }
}
